# PostgreSQL used by the application and Drizzle (required).
# Replace the password in both DATABASE_URL and POSTGRES_PASSWORD with the same strong random value when using Docker Compose.
DATABASE_URL=postgresql://menu_app:replace-with-a-strong-random-password@db:5432/menu_atelier
POSTGRES_USER=menu_app
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=menu_atelier

# Public application address and listening port (required in production).
# NEXT_PUBLIC_* values are bundled into browser code and must never contain secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# Optional public link opened by the QR code after a guest views the receipt.
# Use the exact Google Business "write a review" HTTPS URL; it is returned to the guest browser and must not contain a secret.
GOOGLE_REVIEW_URL=https://g.page/r/CQsw-xr0OEMDECA/review

# Optional stable build identifier. Leave empty to use the checked-in RELEASE file.
NEXT_PUBLIC_APP_BUILD_VERSION=

# Root administrator login (required until database-backed administrators are configured).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

# Server-only signing/encryption secrets (required; use independent random values of at least 32 bytes).
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
WAITER_SESSION_SECRET=replace-with-a-different-32-byte-random-value
# Optional separate key for employee QR cards and private calendar links.
# When empty, the application uses ADMIN_SESSION_SECRET.
WORKFORCE_QR_SECRET=replace-with-another-independent-32-byte-random-value
SYNC_SECRET=replace-with-another-32-byte-random-value

# Shared server-only key used exclusively by EVENT OS to read the selected
# event menu and synchronize events/pre-orders. Configure the same independent
# random value (at least 32 characters) in both applications.
MENU_EVENT_OS_SECRET=replace-with-an-independent-32-byte-random-value

# Dotykačka API endpoint and catalogue settings.
DOTYKACKA_API_URL=https://api.dotykacka.cz/v2
DOTYKACKA_HTTP_TIMEOUT=15
DOTYKACKA_MENU_TAG=menu

# Direct Dotykačka connection (required unless the OAuth-style connector is used from the admin panel).
DOTYKACKA_REFRESH_TOKEN=replace-with-the-dotykacka-refresh-token
DOTYKACKA_CLOUD_ID=replace-with-the-dotykacka-cloud-id

# Optional Dotykačka warehouse and branch selection.
DOTYKACKA_WAREHOUSE_ID=
DOTYKACKA_BRANCH_ID=

# Optional connector credentials for establishing the Dotykačka connection in the admin panel.
DOTYKACKA_CONNECTOR_CLIENT_ID=
DOTYKACKA_CONNECTOR_CLIENT_SECRET=

# TTLock cloud connection used by the server to control locks through the internet gateway.
# Never expose these values through NEXT_PUBLIC_* variables or save them on a tablet.
TTLOCK_CLIENT_ID=
TTLOCK_ACCESS_TOKEN=
TTLOCK_API_BASE_URL=https://api.sciener.com

# Optional webhook signature secret. When empty, the server falls back to SYNC_SECRET.
DOTYKACKA_WEBHOOK_SECRET=

# Safety gates. Keep false until the corresponding production integration has been tested and approved.
WAITER_POS_ACTIONS_ENABLED=false
DOTYKACKA_INVENTORY_WRITE_ENABLED=false
# One-shot safety gate for scripts/migrate-wine-glasses.mjs. Keep false outside a reviewed migration run.
DOTYKACKA_WINE_MIGRATION_WRITE_ENABLED=false
# Optional private backup directory used by the wine migration script.
DOTYKACKA_WINE_MIGRATION_BACKUP_DIR=tmp/wine-migration-backups

# Optional translation service. DEEPL_API_URL may be left empty for automatic Free/Pro endpoint selection.
DEEPL_API_KEY=
DEEPL_API_URL=

# Optional Brave Search enrichment key.
BRAVE_SEARCH_API_KEY=

# Optional bounded build/install timeouts used by the Linux Sites helper scripts.
SITES_INSTALL_TIMEOUT=8m
SITES_INSTALL_KILL_AFTER=15s
SITES_BUILD_TIMEOUT=3m
SITES_BUILD_KILL_AFTER=10s
